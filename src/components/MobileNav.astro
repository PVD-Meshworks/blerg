<style>
header {
  background-color: var(--surface-2);
  padding: var(--size-4);
  width: 100svw;
}

a {
  text-decoration: none;
  color: inherit;
}

h1 {
  display: inline-block;
}

ul {
  list-style-type: none; 
  padding: 0;
}

nav {
  width: 100%;
  height: 100%;
  position: fixed;
  background-color: var(--surface-1);
  overflow: hidden;
}

nav a {
  display: block;
}

nav a:hover {
  background-color: var(--surface-2);
}

nav {
  max-height: 0;
  transition: max-height .2s ease-out;
}

.hamburger {
  cursor: pointer;
  float: right;
  padding-block: var(--size-4);
}

.hamburger-line {
  background: var(--text-1);
  display: block;
  height: var(--size-px-1);
  position: relative;
  width: var(--size-5);
}

.hamburger-line::before,
.hamburger-line::after {
  background: var(--text-1);
  content: '';
  display: block;
  height: 100%;
  position: absolute;
  transition: all .2s ease-out;
  width: 100%;
}

.hamburger-line::before {
  top: var(--size-2);
}

.hamburger-line::after {
  top: calc(-1 * var(--size-2));
}

input {
  display: none;
}

.side-menu:checked ~ nav {
  max-height: 100%;
}

.side-menu:checked ~ .hamburger .hamburger-line {
  background: transparent;
}

.side-menu:checked ~ .hamburger .hamburger-line::before {
  transform: rotate(-45deg);
  top: 0;
}

.side-menu:checked ~ .hamburger .hamburger-line::after {
  transform: rotate(45deg);
  top:0;
}

body:has(.side-menu:checked) {
  overflow: hidden;
}
</style>

<header>
  <h1 class="nav__home"><a href="/">PVD Mesh</a></h1>
  <input class="side-menu" type="checkbox" id="side-menu" />
  <label class="hamburger" for="side-menu"><span class="hamburger-line"></span></label>
  <nav>
    <ul>
      <li><a href="/blerg">Blerg</a></li>
      <li><a href="/bylaws">Bylaws</a></li>
      <li><a href="/contact">Contact</a></li>
      <li><a href="/glossary">Glossary</a></li>
    </ul>
  </nav>
</header>
