---
let { type: btnType = "primary", size = "md", href } = Astro.props;
---

<style>
.btn {
  border-style: solid;
  border-width: var(--size-00);
  border-radius: var(--radius-2);
  text-align: center;
  transform: skew(-20deg);
  transition: background-color 300ms;
}

.inner {
  display: inline-block;
  transform: skew(20deg);
}

.sm {
  font-size: var(--font-size-fluid-1);
  padding-inline: var(--font-size-fluid-1);
}

.md {
  font-size: var(--font-size-fluid-2);
  padding-inline: var(--font-size-fluid-2);
}

.lg {
  font-size: var(--font-size-fluid-3);
  padding-inline: var(--font-size-fluid-3);
}

.primary {
  background-color: var(--brand);
  border-color: var(--brand);
  color: var(--text-1);
}

.primary:hover, .primary:focus {
  background-color: var(--brand-dark);
}

.secondary {
  background-color: var(--surface-1);
  border-color: var(--text-1);
  color: var(--text-1);
}

.secondary:hover, .secondary:focus {
  background-color: var(--surface-2);
}

.ghost {
  background-color: var(--surface-1);
  border-color: var(--text-1);
  color: var(--text-1);
}

.ghost:hover, .ghost:focus {
  background-color: var(--surface-2);
}

.no-link {
  text-decoration: none;  
  color: inherit;
}
</style>

{href ? (
  <a class:list={["btn", btnType, size]} href={href}>
    <span class="inner no-link">
      <slot />
    </span>
  </a>
) : (
  <button class:list={["btn", btnType, size]}>
    <div class="inner">
      <slot />
    </div>
  </button>
)}

