---
let { type: btnType = "primary", size = "md", href } = Astro.props;
---

<style>
.btn {
  border-radius: var(--radius-2);
  text-align: center;
  transform: skew(-20deg);
}

.inner {
  display: inline-block;
  transform: skew(20deg);
}

.sm {
  font-size: var(--font-size-fluid-1);
  padding-inline: var(--font-size-fluid-1);
}

.md {
  font-size: var(--font-size-fluid-2);
  padding-inline: var(--font-size-fluid-2);
}

.lg {
  font-size: var(--font-size-fluid-3);
  padding-inline: var(--font-size-fluid-3);
}

.primary {
  background-color: var(--brand);
  border-color: var(--brand);
  color: var(--text-1);
}

.secondary {
  background-color: var(--surface-1);
  border-color: var(--text-1);
  color: var(--text-1);
}

.ghost {
  background-color: var(--surface-1);
  border-color: var(--text-1);
  color: var(--text-1);
}

.no-link {
  text-decoration: none;  
  color: inherit;
}
</style>

<button class:list={["btn", btnType, size]}>
  <div class="inner">
    {href && <a href={href} class="no-link"><slot /></a>}
    {!href && <slot />}
  </div>
</button>
