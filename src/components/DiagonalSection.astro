---
<style>
.outer {
  padding-block: var(--size-10);
}

.top {
  height: var(--size-fluid-6);
  background-image: linear-gradient(to bottom right, var(--surface-1), var(--surface-1) 50%, var(--text-1) 50%, var(--text-1));
  margin-bottom: -1px;
}

.inner {
  background-color: var(--text-1);
  color: var(--surface-1);
  padding-block: var(--size-6);
  padding-inline: var(--size-fluid-3);
  display: flex;
  justify-content: center;
  align-items: center;
}

.bottom {
  height: var(--size-fluid-6);
  background-image: linear-gradient(to bottom right, var(--text-1), var(--text-1) 50%, var(--surface-1) 50%, var(--surface-1));
  margin-top: -1px;
}
</style>

<div class="outer">
  <div class="top"></div>
  <div class="inner">
    <slot />
  </div>
  <div class="bottom"></div>
</div>
