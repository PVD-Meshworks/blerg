---
import Base from "@/layouts/Base.astro";
import ContentColumn from "@/layouts/ContentColumn.astro";
---

<style>

.nav__home {
  font-size: var(--font-size-fluid-3);
  text-align: center;
}

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.hero--title {}

.hero__title--text {
  font-size: 128px;
  padding-block: 128px;
  text-align: center;
  line-height: 164px;
  text-decoration: underline var(--red-10) var(--size-px-3);
  padding-block: var(--size-8);
  transform: rotate(-5deg);
}

.hero__title--italic {
  font-style: italic;
}

@media (max-width: 560px) {
  .hero__title--text {
    font-size: var(--size-px-10);
    line-height: var(--size-px-11);
    padding-top: var(--size-4);
  }
}

@media (max-width: 360px) {
  .hero__title--text {
    font-size: var(--size-px-8);
    line-height: var(--size-px-9);
    padding-top: var(--size-4);
  }
}


.hero__cta {
  display: flex;
  flex-wrap: wrap;
  gap: var(--size-4);
  margin-block: var(--size-4);
  justify-content: center;
  align-items: center;
}

.hero__btn {
  font-size: var(--font-size-fluid-2);
  border-radius: var(--radius-2);
  min-width: 300px;
  transform: skew(-20deg);
  text-align: center;
  cusror: pointer;
}

.hero__btn--primary {
  background-color: var(--stone-0);
  border-color: var(--stone-0);
  color: var(--stone-12)
}

.hero__btn--secondary {
  background-color: var(--stone-12);
  border-color: var(--stone-0);
  color: var(--stone-0);
}

.hero__btn--inner {
  display: inline-block;
  transform: skew(20deg);
  text-decoration: none;
  color: inherit;
}

.overview {
  padding-block: var(--size-10);
}
.overview__top {
  height: var(--size-fluid-6);
  background-image: linear-gradient(to bottom right, var(--stone-12), var(--stone-12) 50%, var(--stone-0) 50%, var(--stone-0));
}

.overview__inner {
  background-color: var(--stone-0);
  color: var(--stone-12);
  padding-block: var(--size-6);
  padding-inline: var(--size-fluid-3);
  font-size: var(--font-size-fluid-1);
  display: flex;
  justify-content: center;
  align-items: center;
}

.overview__inner--text {
  width: 50ch;
  max-width: var(--size-content-3);

  p {
    padding-block: var(--size-5);
  }
}

.overview__bottom {
  height: var(--size-fluid-6);
  background-image: linear-gradient(to bottom right, var(--stone-0), var(--stone-0) 50%, var(--stone-12) 50%, var(--stone-12));
}

.pilot {
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: var(--font-size-fluid-1);
  padding-block: var(--size-4);
}

.pilot__inner {
  width: 50ch;
  max-width: var(--size-content-3);
  padding-inline: var(--size-fluid-3);

  p {
    padding-block: var(--size-5);
  }

  h2 {
    text-align: center;
    font-size: var(--font-size-fluid-3);
    text-decoration: underline var(--red-10) var(--size-px-2);
    padding-block: var(--size-8);
  }
}

</style>

<Base>
    <nav class="nav">
      <h1 class="nav__home">Providence Meshworks</h1>
    </nav>
    <section>
      <div class="hero">
        <div class="hero__title">
          <h1 class="hero__title--text">
            The Internet <br>
            <span class="hero__title--italic">belongs</span>
            <br> to the People
          </h1>
        </div>
      </div>
    </section>
    <section class="hero__cta">
      <button class="hero__btn hero__btn--primary">
        <a href="#pilot" class="hero__btn--inner">Join the Effort</a>
      </button>
      <button class="hero__btn hero__btn--secondary">
        <a href="#overview" class="hero__btn--inner">Learn More</a>
      </button>
    </section>
    <section id="overview" class="overview">
